source "https://rubygems.org"

# Jekyll plugins
gem "jekyll", "~> 3.0"
gem "just-the-docs", "~> 0.7"
# Jekyll 3 dependencies require these gems explicitly on recent Ruby versions.
gem "base64", "~> 0.2"
gem "bigdecimal", ">= 3.1", "< 5"

# Markdown and AsciiDoc processing
gem "asciidoctor", "~> 2.0"
gem "jekyll-asciidoc", "~> 3.0"
gem "kramdown-parser-gfm"

# SEO and metadata
gem "jekyll-seo-tag", "~> 2.0"
gem "jekyll-sitemap", "~> 1.0"

# Windows compatibility
gem "jekyll-watch", "~> 2.0", platforms: %i[mingw x64_mingw]
gem "wdm", "~> 0.1", platforms: %i[mingw x64_mingw]
